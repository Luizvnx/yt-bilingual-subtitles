{
  "name": "yt-bilingual-subtitles-saas",
  "version": "1.0.0",
  "description": "SaaS para Estudo de Idiomas com Vídeos do YouTube",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend start",
    "lint": "npm --prefix frontend run lint",
    "deploy:prod": "bash deploy.sh",
    "deploy:stage": "bash deploy-stage.sh",
    "stage:up": "docker compose --env-file .env.stage -f docker-compose.stage.yml up -d",
    "stage:down": "docker compose --env-file .env.stage -f docker-compose.stage.yml down",
    "stage:logs": "docker compose --env-file .env.stage -f docker-compose.stage.yml logs -f app_stage"
  },
  "keywords": ["saas", "language-learning", "subtitles", "youtube", "nextjs", "react"],
  "author": "Luizvnx",
  "license": "ISC"
}
