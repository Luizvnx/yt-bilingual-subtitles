# Configurações do SaaS YT Bilingual Subtitles
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave secreta para assinatura dos tokens JWT em Cookies HttpOnly
JWT_SECRET=sua_chave_secreta_jwt_de_pelo_menos_32_caracteres_aqui

# Google OAuth 2.0 (Obtenha no Google Cloud Console -> APIs & Services -> Credentials)
# URI de Redirecionamento autorizada: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=seu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui
