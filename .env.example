# ========================================================
# YT BILINGUAL SUBTITLES — VARIÁVEIS DE AMBIENTE (PRODUÇÃO)
# ========================================================

# --- REDE E PORTAS ---
# Porta em que a aplicação responderá na VPS (ex: 3000 ou 80 se direto no host)
APP_PORT=3000

# Porta do PostgreSQL exposta no host da VPS
POSTGRES_HOST_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=insira_uma_senha_forte_aqui_ex_postgres_2026_xyz
POSTGRES_DB=yt_bilingual_subtitles

# Conexão interna com o banco de dados
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# --- SEGURANÇA & SESSÃO (OBRIGATÓRIO) ---
# Chave secreta de alta entropia para assinatura de tokens JWT e cookies de autenticação
# Gere com: openssl rand -hex 32
JWT_SECRET=gere_uma_chave_aleatoria_longa_aqui_ex_openssl_rand_hex_32

# URL pública oficial onde a aplicação é acessada (usada para callbacks de OAuth e Webhooks)
# Exemplo para IP direto: http://137.131.164.202
# Exemplo para domínio: https://ingles.seudominio.com
NEXT_PUBLIC_BASE_URL=http://137.131.164.202
NEXT_PUBLIC_APP_URL=http://137.131.164.202

# --- INTELIGÊNCIA ARTIFICIAL PARA TRANSCRIÇÃO (MUITO RECOMENDADO) ---
# Se o YouTube não tiver legendas nativas ou bloquear extração em VPS, o sistema usa
# o Whisper em nuvem para transcrever o áudio do vídeo em menos de 2 segundos.
# Obtenha GRÁTIS em: https://console.groq.com/keys (30 requisições/minuto gratuitas)
GROQ_API_KEY=

# (Opcional - Alternativa ao Groq) Chave da OpenAI para Whisper
OPENAI_API_KEY=

# --- GOOGLE YOUTUBE DATA API (RECOMENDADO) ---
# Permite extrair metadados oficiais (título, canal, duração exata em segundos)
# mesmo que o yt-dlp enfrente bloqueios de IP na VPS.
# Obtenha em: Google Cloud Console -> APIs e Serviços -> YouTube Data API v3 -> Criar Chave de API
YOUTUBE_API_KEY=

# --- GOOGLE OAUTH 2.0 (OPCIONAL - LOGIN SOCIAL) ---
# Permite login com conta Google oficial com foto de perfil e e-mail verificado.
# Obtenha em: Google Cloud Console -> Credenciais -> ID do cliente OAuth 2.0
# URI de Redirecionamento autorizada: http://SEU_DOMINIO_OU_IP/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- PAGAMENTOS STRIPE (OPCIONAL - MONETIZAÇÃO SAAS) ---
# Se deixado em branco, o sistema funciona em modo demonstração
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
