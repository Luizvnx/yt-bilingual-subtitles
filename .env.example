# ========================================================
# YT BILINGUAL SUBTITLES — VARIÁVEIS DE AMBIENTE (PRODUÇÃO)
# ========================================================

# Porta da aplicação web na VPS (padrão: 3000)
APP_PORT=3000

# Porta do PostgreSQL exposta no host (5433 evita conflito com outros bancos como o do WhatsApp)
POSTGRES_HOST_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=insira_uma_senha_forte_aqui
POSTGRES_DB=yt_bilingual_subtitles

# Conexão com o banco (usada pelo Prisma e Next.js)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Chave secreta para assinatura dos Cookies HttpOnly (JWT)
JWT_SECRET=gere_uma_chave_aleatoria_longa_aqui_ex_openssl_rand_hex_32

# URL pública da aplicação (com seu domínio na VPS, ex: https://estudos.seudominio.com)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth 2.0 (Opcional - para login com foto real do Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Billing (Opcional - em branco ativa o modo demonstração/sandbox)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
