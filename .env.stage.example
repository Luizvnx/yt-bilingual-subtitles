# ========================================================
# YT BILINGUAL SUBTITLES — VARIÁVEIS DE AMBIENTE (STAGE / TESTES)
# ========================================================
# Este ambiente roda isolado da produção (porta 3001 e postgres 5434)
# permitindo testes pré-deploy na mesma VPS sem risco de indisponibilidade.

# Identificador de Ambiente
NEXT_PUBLIC_ENVIRONMENT=stage

# --- REDE E PORTAS (ISOLADAS DE PRODUÇÃO) ---
# Porta da aplicação de Stage (Produção usa 3000)
STAGE_APP_PORT=3001

# Porta do PostgreSQL exposta no host para Stage (Produção usa 5433, WhatsApp usa 5432)
STAGE_POSTGRES_HOST_PORT=5434
POSTGRES_USER=postgres_stage
POSTGRES_PASSWORD=stage_secure_password_test_2026
POSTGRES_DB=yt_bilingual_subtitles_stage

# Conexão interna do container com o banco de Stage
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres_stage:5432/${POSTGRES_DB}?schema=public

# --- SEGURANÇA & SESSÃO (STAGE) ---
JWT_SECRET=stage_super_secret_jwt_subtitles_saas_2026_test

# URL pública para o ambiente de Stage
# Se na VPS direta por IP: http://SEU_IP_OU_DOMINIO:3001
# Se com subdomínio configurado: https://stage.seudominio.com
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- INTELIGÊNCIA ARTIFICIAL PARA TRANSCRIÇÃO (TESTES) ---
# Chave Groq para Whisper ultra-rápido (obtenha grátis em https://console.groq.com/keys)
GROQ_API_KEY=

# (Opcional) OpenAI Whisper
OPENAI_API_KEY=

# --- GOOGLE YOUTUBE DATA API (TESTES) ---
YOUTUBE_API_KEY=

# --- GOOGLE OAUTH 2.0 (OPCIONAL EM STAGE) ---
# Nota: adicione http://localhost:3001/api/auth/google/callback nas URIs autorizadas do Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- STRIPE (TESTES) ---
# Utilize as chaves no modo de teste do Stripe (pk_test_... / sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CONTORNO DE BLOQUEIO DE IP EM VPS / DATACENTER ---
YOUTUBE_COOKIES=

# Proxy SOCKS5 do container WARP exclusivo de Stage
YOUTUBE_PROXY=socks5://warp_stage:1080
